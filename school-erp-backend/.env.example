# Shared secret across ALL services - must be identical everywhere.
# MUST be at least 32 characters. Read ONLY from the environment; no fallback,
# and every service refuses to start without a valid value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed CORS origins (comma separated) for browser clients
CORS_ORIGIN=http://localhost:5173

# Mongo (single cluster, separate logical DBs per service)
MONGO_URI_BASE=mongodb://mongo:27017

# Service ports
GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
STUDENT_SERVICE_PORT=5002
STAFF_SERVICE_PORT=5003
ACADEMIC_SERVICE_PORT=5004
FEE_SERVICE_PORT=5005
COMMUNICATION_SERVICE_PORT=5006
LIBRARY_SERVICE_PORT=5007
FACILITY_SERVICE_PORT=5008

# Internal service URLs (used by gateway + inter-service calls)
AUTH_SERVICE_URL=http://auth-service:5001
STUDENT_SERVICE_URL=http://student-service:5002
STAFF_SERVICE_URL=http://staff-service:5003
ACADEMIC_SERVICE_URL=http://academic-service:5004
FEE_SERVICE_URL=http://fee-service:5005
COMMUNICATION_SERVICE_URL=http://communication-service:5006
LIBRARY_SERVICE_URL=http://library-service:5007
FACILITY_SERVICE_URL=http://facility-service:5008
