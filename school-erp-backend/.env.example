# =============================================================================
# School ERP Backend — environment template (copy to `.env` and fill in).
# .env is gitignored; ONLY this template is committed. Never put real secrets
# or real MongoDB URIs here.
# =============================================================================

# --- Authentication ----------------------------------------------------------
# Shared secret across ALL services - must be identical everywhere.
# MUST be at least 32 characters. Read ONLY from the environment; no fallback,
# and every service refuses to start without a valid value.
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS --------------------------------------------------------------------
# Allowed CORS origins (comma separated) for browser clients
CORS_ORIGIN=http://localhost:5173

# --- MongoDB (one logical database per microservice) ------------------------
# Each service reads ONLY its own variable. Fill with either a local URI
# (mongodb://localhost:27017/erp_auth) or a MongoDB Atlas URI for development.
AUTH_MONGODB_URI=
STUDENT_MONGODB_URI=
STAFF_MONGODB_URI=
ACADEMIC_MONGODB_URI=
FEE_MONGODB_URI=
COMMUNICATION_MONGODB_URI=
LIBRARY_MONGODB_URI=
FACILITY_MONGODB_URI=

# Optional fallback for scripts/seed-full.js only: a cluster base URL
# (no database name). The seed script builds the per-service database from it
# when the service-specific *_MONGODB_URI vars above are empty.
# MONGO_URI_BASE=mongodb://localhost:27017

# --- Token validation --------------------------------------------------------
# When set to "off", downstream services skip local JWT validation against the
# shared User collection (development only). Any other value keeps it enabled.
TOKEN_VALIDATION=on

# --- Internal service-to-service notifications --------------------------------
# Shared key used by microservices to fan out inbox notifications to users by
# refId (e.g. homework submission -> student). Must match across all services.
# INTERNAL_NOTIFY_KEY=change-me-to-a-random-secret-at-least-32-characters

# --- ImageKit (image upload, used by 7 services) ----------------------------
# Required by auth/student/academic/fee/communication/library/facility services.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Service ports -----------------------------------------------------------
GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
STUDENT_SERVICE_PORT=5002
STAFF_SERVICE_PORT=5003
ACADEMIC_SERVICE_PORT=5004
FEE_SERVICE_PORT=5005
COMMUNICATION_SERVICE_PORT=5006
LIBRARY_SERVICE_PORT=5007
FACILITY_SERVICE_PORT=5008

# --- API Gateway -------------------------------------------------------------
# Internal service URLs (used by the gateway + inter-service calls)
PROXY_TIMEOUT_MS=10000
AUTH_SERVICE_URL=http://localhost:5001
STUDENT_SERVICE_URL=http://localhost:5002
STAFF_SERVICE_URL=http://localhost:5003
ACADEMIC_SERVICE_URL=http://localhost:5004
FEE_SERVICE_URL=http://localhost:5005
COMMUNICATION_SERVICE_URL=http://localhost:5006
LIBRARY_SERVICE_URL=http://localhost:5007
FACILITY_SERVICE_URL=http://localhost:5008

# --- Online fee payment (payment-order abstraction) --------------------------
# Provider integration is deployment work. Until PAYMENT_PROVIDER_ENABLED=true
# AND PAYMENT_PROVIDER_NAME is set, orders can be created but can never be
# confirmed as paid (confirm route returns 503). No fake payments are possible.
# PAYMENT_PROVIDER_ENABLED=false
# PAYMENT_PROVIDER_NAME=razorpay
# PAYMENT_PROVIDER_WEBHOOK_SECRET=
# PAYMENT_PROVIDER_CHECKOUT_BASE=