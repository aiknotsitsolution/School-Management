# Internal service URLs (used by gateway + inter-service calls)
# NOTE: Use localhost hostnames when running services directly on the host
# (npm run dev:all). For Docker mode (npm run docker:up) the gateway runs in a
# container and needs the Docker service names (auth-service, student-service, ...).
# On Render, override these via Dashboard env vars (e.g. FEE_SERVICE_URL for Instance 1,
# AUTH_SERVICE_URL for Instance 2).
AUTH_SERVICE_URL=http://localhost:5001
STUDENT_SERVICE_URL=http://localhost:5002
