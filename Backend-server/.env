# --- Place search (geocoding) --------------------------------------------------
# Powers the branch form's location search and the transport route planner's
# stop search. Google Places is the default because OpenStreetMap has no entry
# for many individual schools — searching a campus by name returns nothing.
#
# TODO(you): paste your Google Cloud key below, then restart facility-service.
# Without it the search is refused and the UI says so instead of silently
# showing an empty dropdown. See Backend-server/.env.example for the full
# provider options (nominatim / photon).
GEOCODER_ENABLED=true
GEOCODER_PROVIDER=google
GOOGLE_PLACES_API_KEY=
GEOCODER_LANGUAGE=en
GEOCODER_CACHE_TTL_MS=900000
GEOCODER_TIMEOUT_MS=8000
GEOCODER_MAX_RESULTS=8


